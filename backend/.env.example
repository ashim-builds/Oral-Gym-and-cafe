# Server Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# CloudLinux & Low-Resource Node Process Constraints
TOKIO_WORKER_THREADS=1
UV_THREADPOOL_SIZE=2

# MySQL Database Connection URL (Prisma)
# Append connection_limit=3&pool_timeout=10 to cap database connection threads on cPanel/CloudLinux
DATABASE_URL="mysql://root:root@localhost:3306/oral_gym_db?connection_limit=3&pool_timeout=10"

# JWT Authentication Secrets
JWT_SECRET="oral_gym_customer_jwt_secret_production_ready_key_2026"
JWT_EXPIRES_IN="30d"

ADMIN_JWT_SECRET="oral_gym_admin_jwt_secret_production_ready_key_2026"
ADMIN_JWT_EXPIRES_IN="7d"

# OTP Service Configuration (mock enables dev logging of OTP without sending live SMS)
# OTP_PROVIDER options: mock | sparrow | twilio | custom
OTP_PROVIDER=mock
OTP_API_KEY=
OTP_API_SECRET=
OTP_SENDER_ID=ORALGYM
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Store / Checkout Settings
DEFAULT_DELIVERY_CHARGE=150.00
